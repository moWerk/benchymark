[Desktop Entry]
Type=Application
X-Nemo-Application-Type=silica-qt5
Icon=harbour-benchymark
Exec=harbour-benchymark
Name=Benchymark
Comment=A rendering benchmark

[X-Sailjail]
# Sandboxed. The app draws, writes its last result to its own data directory,
# and saves a picture of the results to Pictures to share it (Pictures).
OrganizationName=net.mowerk
ApplicationName=harbour-benchymark
Permissions=Pictures
